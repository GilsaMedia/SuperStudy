rules_version = '2';

// SuperStudy Firestore security rules.
// Covers every collection the app uses:
//   users/{uid}                         – profiles (student & teacher)
//   users/{teacherId}/students/{id}     – a teacher's linked students
//   users/{teacherId}/ratings/{id}      – ratings a student gives a teacher (docId == student uid)
//   users/{uid}/calendar/{id}           – per-user copy of scheduled lessons
//   appointments/{id}                   – canonical lesson records
//
// Principle: must be signed in for everything; a user may only create/edit
// their OWN profile. Cross-user writes are limited to what the app does:
// a teacher links students and writes lesson copies into a student's calendar,
// a student can leave a teacher and rate a teacher they are linked to.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{userId} {
      // Any signed-in user can read profiles (students browse teachers,
      // teachers search students).
      allow read: if signedIn();
      // A user may only create/update/delete their OWN profile document —
      // with ANY fields (student or teacher). THIS FIXES SIGN-UP.
      allow create, update, delete: if isSelf(userId);

      // Teacher's linked students. Only the teacher adds/edits; a student may
      // remove their own membership ("Leave teacher").
      match /students/{studentId} {
        allow read: if signedIn();
        allow create, update: if isSelf(userId);
        allow delete: if isSelf(userId) || isSelf(studentId);
      }

      // Ratings: the doc id is the rating student's uid. Only a student linked
      // to this teacher may rate (1-5), and nobody may rate themselves.
      match /ratings/{studentId} {
        allow read: if signedIn();
        allow create, update: if isSelf(studentId) && studentId != userId
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && exists(/databases/$(database)/documents/users/$(userId)/students/$(studentId));
        allow delete: if isSelf(studentId);
      }

      // Per-user calendar copies. The owner manages their own; a teacher may
      // write a lesson into a student's calendar; either side of a lesson may
      // delete its copy (remove student / leave teacher). `resource == null`
      // lets batch deletes of an already-missing copy succeed.
      match /calendar/{appointmentId} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          || (signedIn() && request.resource.data.teacherId == request.auth.uid);
        allow delete: if isSelf(userId) || (signedIn() && (resource == null
          || resource.data.teacherId == request.auth.uid
          || resource.data.studentId == request.auth.uid));
      }
    }

    // Canonical appointment records.
    match /appointments/{appointmentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signedIn() &&
        (resource.data.teacherId == request.auth.uid ||
         resource.data.studentId == request.auth.uid);
    }
  }
}
